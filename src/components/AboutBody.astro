---
import { Image } from 'astro:assets';
import perfil from '../assets/perfil.jpeg';
import { SITE, type Lang } from '../site.config';
import { useTranslations } from '../i18n/utils';
import { about } from '../data/about';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = about[lang];
---

<section class="wrap page-head">
  <p class="label">{t('about.eyebrow')}</p>
  <h1 class="display-m">{a.h1}</h1>
</section>

<section class="wrap about__top">
  <div class="about__intro">
    {a.intro.map((p) => <p>{p}</p>)}
  </div>
  <figure class="about__photo">
    <Image
      src={perfil}
      alt={SITE.name}
      widths={[300, 520, 760]}
      sizes="(max-width: 820px) 60vw, 300px"
      format="webp"
    />
  </figure>
</section>

<section class="wrap about__grid reveal">
  <div class="about__block">
    <h2 class="label">{t('about.stack.title')}</h2>
    <dl class="stack">
      {
        a.stack.map((group) => (
          <div class="stack__row">
            <dt>{group.label}</dt>
            <dd>{group.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="about__block">
    <h2 class="label">{a.how.title}</h2>
    <ul class="bullets">
      {a.how.items.map((i) => <li>{i}</li>)}
    </ul>
  </div>

  <div class="about__block">
    <h2 class="label">{a.now.title}</h2>
    <ul class="bullets">
      {a.now.items.map((i) => <li>{i}</li>)}
    </ul>
  </div>
</section>

<section class="wrap about__contact" id="contact">
  <h2 class="display-s">{a.contact.title}</h2>
  <p class="lede">{a.contact.lede}</p>

  <form
    class="cform"
    id="contact-form"
    action="/api/contact"
    method="post"
    novalidate
    data-sending={t('form.sending')}
    data-ok={t('form.ok')}
    data-error={t('form.error')}
  >
    <div class="cform__row">
      <div class="field">
        <label for="cf-name">{t('form.name')}</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="120" />
      </div>
      <div class="field">
        <label for="cf-email">{t('form.email')}</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="200" />
      </div>
    </div>

    <div class="field">
      <label for="cf-message">{t('form.message')}</label>
      <textarea id="cf-message" name="message" required rows="6" minlength="10" maxlength="5000"></textarea>
    </div>

    <div class="hp" aria-hidden="true">
      <label for="cf-company">Company</label>
      <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="cform__foot">
      <button class="btn btn--primary" type="submit" data-send>{t('form.send')}</button>
      <p class="cform__status" role="status" aria-live="polite"></p>
    </div>
  </form>

  <p class="about__or">{t('form.or')} <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>

  <div class="about__links">
    <a class="btn btn--ghost" href={SITE.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    <a class="btn btn--ghost" href={SITE.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
  </div>
</section>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var btn = form.querySelector('[data-send]');
    var status = form.querySelector('.cform__status');
    var idle = btn ? btn.textContent : '';
    var msg = { sending: form.dataset.sending, ok: form.dataset.ok, error: form.dataset.error };

    function setStatus(text, kind) {
      if (!status) return;
      status.textContent = text || '';
      status.classList.toggle('is-ok', kind === 'ok');
      status.classList.toggle('is-error', kind === 'error');
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      if (!form.reportValidity()) return;

      if (btn) {
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = msg.sending;
      }
      setStatus(msg.sending, 'pending');

      try {
        var res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
        });
        var data = await res.json().catch(function () {
          return {};
        });
        if (res.ok && data.ok) {
          form.reset();
          setStatus(msg.ok, 'ok');
        } else {
          setStatus(msg.error, 'error');
        }
      } catch (err) {
        setStatus(msg.error, 'error');
      } finally {
        if (btn) {
          btn.removeAttribute('aria-busy');
          btn.textContent = idle;
        }
      }
    });
  })();
</script>

<style>
  .page-head {
    padding-block: var(--s-24) var(--s-12);
    display: grid;
    gap: var(--s-5);
    max-width: 46rem;
  }

  .page-head h1 {
    max-width: 22ch;
  }

  @media (max-width: 620px) {
    .page-head {
      padding-block: var(--s-12) var(--s-10);
    }
  }

  .about__top {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--s-12);
    align-items: start;
  }

  .about__intro {
    display: grid;
    gap: var(--s-5);
    max-width: 60ch;
  }

  .about__intro p {
    color: var(--fg-2);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .about__photo {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--surface-2);
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-8);
    margin-top: var(--s-16);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
  }

  .about__block {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .stack {
    display: grid;
    gap: var(--s-4);
    margin: 0;
  }

  .stack__row {
    display: grid;
    gap: var(--s-1);
  }

  .stack__row dt {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .stack__row dd {
    margin: 0;
    color: var(--fg-2);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .bullets li {
    color: var(--fg-2);
    padding-left: var(--s-5);
    position: relative;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
  }

  .about__contact {
    margin-top: var(--s-24);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    max-width: 44rem;
  }

  .cform {
    width: 100%;
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-4);
  }

  .cform__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-5);
  }

  .cform__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
  }

  .cform__status {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .cform__status.is-ok {
    color: var(--accent-ink);
  }

  .cform__status.is-error {
    color: #a42025;
  }

  [data-theme='dark'] .cform__status.is-error {
    color: #ff8080;
  }

  .btn[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }

  /* Trampa para bots: fuera de pantalla y fuera del orden de tabulación */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .about__or {
    font-size: var(--text-sm);
    color: var(--fg-2);
    margin-top: var(--s-3);
  }

  .about__links {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  @media (max-width: 820px) {
    .about__top {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .about__photo {
      max-width: 240px;
    }
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }

  @media (max-width: 620px) {
    .about__contact {
      max-width: none;
    }
    .cform__row {
      grid-template-columns: 1fr;
    }
  }
</style>
