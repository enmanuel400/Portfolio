---
import { Image } from 'astro:assets';
import perfil from '../assets/perfil.jpeg';
import { SITE, type Lang } from '../site.config';
import { useTranslations } from '../i18n/utils';
import { about } from '../data/about';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const a = about[lang];
---

<section class="wrap page-head">
  <p class="label">{t('about.eyebrow')}</p>
  <h1 class="display-m">{a.h1}</h1>
</section>

<section class="wrap about__top">
  <div class="about__intro">
    {a.intro.map((p) => <p>{p}</p>)}
  </div>
  <figure class="about__photo">
    <Image
      src={perfil}
      alt={SITE.name}
      widths={[300, 520, 760]}
      sizes="(max-width: 820px) 60vw, 300px"
      format="webp"
    />
  </figure>
</section>

<section class="wrap about__grid reveal">
  <div class="about__block">
    <h2 class="label">{t('about.stack.title')}</h2>
    <dl class="stack">
      {
        a.stack.map((group) => (
          <div class="stack__row">
            <dt>{group.label}</dt>
            <dd>{group.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="about__block">
    <h2 class="label">{a.how.title}</h2>
    <ul class="bullets">
      {a.how.items.map((i) => <li>{i}</li>)}
    </ul>
  </div>

  <div class="about__block">
    <h2 class="label">{a.now.title}</h2>
    <ul class="bullets">
      {a.now.items.map((i) => <li>{i}</li>)}
    </ul>
  </div>
</section>

<section class="wrap about__contact" id="contact">
  <h2 class="display-s">{a.contact.title}</h2>
  <p class="lede">{a.contact.lede}</p>
  <p class="about__email">
    <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </p>
  <div class="about__links">
    <a class="btn btn--ghost" href={SITE.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    <a class="btn btn--ghost" href={SITE.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
  </div>
</section>

<style>
  .page-head {
    padding-block: var(--s-24) var(--s-12);
    display: grid;
    gap: var(--s-5);
    max-width: 46rem;
  }

  .page-head h1 {
    max-width: 22ch;
  }

  .about__top {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: var(--s-12);
    align-items: start;
  }

  .about__intro {
    display: grid;
    gap: var(--s-5);
    max-width: 60ch;
  }

  .about__intro p {
    color: var(--fg-2);
    font-size: var(--text-lg);
    text-wrap: pretty;
  }

  .about__photo {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--surface-2);
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-8);
    margin-top: var(--s-16);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
  }

  .about__block {
    display: grid;
    gap: var(--s-5);
    align-content: start;
  }

  .stack {
    display: grid;
    gap: var(--s-4);
    margin: 0;
  }

  .stack__row {
    display: grid;
    gap: var(--s-1);
  }

  .stack__row dt {
    font-weight: 600;
    font-size: var(--text-sm);
  }

  .stack__row dd {
    margin: 0;
    color: var(--fg-2);
    font-size: var(--text-sm);
    font-family: var(--font-sans);
  }

  .bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .bullets li {
    color: var(--fg-2);
    padding-left: var(--s-5);
    position: relative;
  }

  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
  }

  .about__contact {
    margin-top: var(--s-24);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .about__email {
    font-size: var(--text-lg);
    margin-top: var(--s-2);
  }

  .about__links {
    display: flex;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }

  @media (max-width: 820px) {
    .about__top {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .about__photo {
      max-width: 240px;
    }
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
  }
</style>
