---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import inicioImg from '../assets/projects/miso-inicio.webp';
import fichaImg from '../assets/projects/miso-ficha.webp';
import reproductorImg from '../assets/projects/miso-reproductor.webp';
import type { Lang } from '../site.config';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'projects'>;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const t = useTranslations(lang);
const { data } = entry;
const { Content } = await render(entry);

const all = await getCollection('projects', ({ data: d }) => d.lang === lang);
const ordered = all.sort((a, b) => a.data.order - b.data.order);
const idx = ordered.findIndex((p) => p.id === entry.id);
const next = ordered[(idx + 1) % ordered.length];
---

<article class="case">
  <header class="wrap case__head">
    <a class="label case__back" href={localizePath('/work', lang)}>← {t('case.back')}</a>
    <h1 class="display-l case__title">{data.title}</h1>
    <p class="lede case__lede">{data.lede}</p>

    <dl class="meta">
      <div class="meta__item">
        <dt class="label">{t('case.role')}</dt>
        <dd>{data.role}</dd>
      </div>
      <div class="meta__item">
        <dt class="label">{t('case.year')}</dt>
        <dd>{data.year}</dd>
      </div>
      <div class="meta__item">
        <dt class="label">{t('case.status')}</dt>
        <dd>{data.status}</dd>
      </div>
    </dl>

    <div class="case__foot">
      <ul class="tags">
        {data.stack.map((s: string) => <li class="tag">{s}</li>)}
      </ul>
      <div class="case__links">
        {
          data.repo && (
            <a class="btn btn--ghost" href={data.repo} target="_blank" rel="noreferrer">
              {t('case.repo')} ↗
            </a>
          )
        }
        {
          data.live && (
            <a class="btn btn--primary" href={data.live} target="_blank" rel="noreferrer">
              {t('case.live')} ↗
            </a>
          )
        }
      </div>
    </div>
  </header>

  <div class="wrap case__hero">
    <div class="carousel" aria-label="Capturas de miso">
      <div class="carousel__track" id="miso-track">
        <figure class="carousel__slide"><Image src={data.image} alt="Miso — búsqueda federada" widths={[600,1000,1440]} sizes="100vw" format="webp" /><figcaption>Búsqueda federada</figcaption></figure>
        <figure class="carousel__slide"><Image src={inicioImg} alt="Miso — pantalla de inicio" widths={[600,1000]} sizes="100vw" format="webp" /><figcaption>Inicio</figcaption></figure>
        <figure class="carousel__slide"><Image src={fichaImg} alt="Miso — ficha de título" widths={[600,1000]} sizes="100vw" format="webp" /><figcaption>Ficha</figcaption></figure>
        <figure class="carousel__slide"><Image src={reproductorImg} alt="Miso — reproductor integrado" widths={[600,1000]} sizes="100vw" format="webp" /><figcaption>Reproductor</figcaption></figure>
      </div>
      <div class="carousel__dots" aria-hidden="true">
        <button onclick="document.getElementById('miso-track').scrollTo({left:0,behavior:'smooth'})" aria-label="1"></button>
        <button onclick="document.getElementById('miso-track').scrollTo({left:document.getElementById('miso-track').clientWidth,behavior:'smooth'})" aria-label="2"></button>
        <button onclick="document.getElementById('miso-track').scrollTo({left:document.getElementById('miso-track').clientWidth*2,behavior:'smooth'})" aria-label="3"></button>
        <button onclick="document.getElementById('miso-track').scrollTo({left:document.getElementById('miso-track').clientWidth*3,behavior:'smooth'})" aria-label="4"></button>
      </div>
    </div>
  </div>

  <div class="wrap--narrow prose reveal">
    <Content />
  </div>

  <nav class="wrap case__next reveal" aria-label={t('case.next')}>
    <a href={localizePath(`/work/${next.data.slug}`, lang)}>
      <span class="label">{t('case.next')}</span>
      <span class="case__next-title">{next.data.title} →</span>
    </a>
  </nav>
</article>

<style>
  .case__head {
    padding-block: var(--s-24) var(--s-12);
    display: grid;
    gap: var(--s-5);
    max-width: 46rem;
  }

  @media (max-width: 620px) {
    .case__head {
      padding-block: var(--s-12) var(--s-10);
    }
  }

  .case__back {
    color: var(--muted);
    width: fit-content;
    transition: color var(--dur-1) var(--ease);
  }

  @media (hover: hover) {
    .case__back:hover {
      color: var(--fg);
    }
  }

  .case__title {
    margin-top: var(--s-2);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-8);
    margin-top: var(--s-4);
  }

  .meta__item {
    display: grid;
    gap: var(--s-1);
  }

  .meta__item dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .case__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-4);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
  }

  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .case__hero {
    margin-block: var(--s-8) var(--s-16);
  }

  .case__hero :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    background: var(--surface-2);
  }

  .case__next {
    margin-top: var(--s-24);
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: flex-end;
  }

  .case__next a {
    display: grid;
    gap: var(--s-1);
    text-align: right;
  }

  .carousel {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--r-2);
  background: var(--surface-2);
}
.carousel__track {
  display: flex;
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.carousel__track::-webkit-scrollbar { display: none; }
.carousel__slide {
  flex: 0 0 100%;
  scroll-snap-align: start;
  position: relative;
}
.carousel__slide img,
.carousel__slide :global(img) {
  width: 100%;
  height: auto;
  aspect-ratio: 16/10;
  object-fit: cover;
  display: block;
}
.carousel__slide figcaption {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: .6rem 1rem;
  background: linear-gradient(transparent, rgba(14,16,18,.85));
  color: #fff;
  font-size: .8rem;
  letter-spacing: .02em;
}
.carousel__dots {
  display: flex;
  justify-content: center;
  gap: .5rem;
  padding: .5rem 0 .75rem;
}
.carousel__dots button {
  width: 8px; height: 8px;
  border-radius: 50%;
  border: none;
  background: var(--line);
  cursor: pointer;
  transition: background .2s;
}
.carousel__dots button:hover,
.carousel__dots button:focus { background: var(--accent); }

.case__next-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

</style>
