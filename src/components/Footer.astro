---
import Monogram from './Monogram.astro';
import { SITE, type Lang } from '../site.config';
import { useTranslations, localizePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const mailto = `mailto:${SITE.email}`;
---

<footer class="ftr">
  <div class="wrap ftr__in">
    <div class="ftr__brand">
      <a class="ftr__logo" href={localizePath('/', lang)} aria-label={SITE.name}>
        <Monogram variant="block" size={32} decorative />
      </a>
      <p class="ftr__role">{SITE.name} · {t('brand.role')}</p>
    </div>

    <nav class="ftr__links" aria-label="Contact">
      <a href={SITE.links.github} rel="me noreferrer" target="_blank">GitHub</a>
      <a href={SITE.links.linkedin} rel="me noreferrer" target="_blank">LinkedIn</a>
      <a href={mailto}>{SITE.email}</a>
    </nav>

    <div class="ftr__meta">
      <span class="mono">{t('footer.rights')}</span>
      <span class="mono">{t('footer.built')}</span>
      <a class="ftr__top" href="#main">{t('footer.top')} ↑</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    margin-top: var(--s-24);
    border-top: 1px solid var(--line);
  }

  .ftr__in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--s-6);
    padding-block: var(--s-8);
  }

  .ftr__brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .ftr__role {
    font-size: var(--text-sm);
    color: var(--fg-2);
  }

  .ftr__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    justify-content: center;
  }

  .ftr__links a {
    font-size: var(--text-sm);
    color: var(--fg-2);
    transition: color var(--dur-1) var(--ease);
  }

  .ftr__links a:hover {
    color: var(--accent-ink);
  }

  .ftr__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-1);
    color: var(--muted);
    font-size: var(--text-xs);
    font-family: var(--font-sans);
  }

  .ftr__top {
    color: var(--muted);
    transition: color var(--dur-1) var(--ease);
  }

  .ftr__top:hover {
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .ftr__in {
      grid-template-columns: 1fr;
      justify-items: start;
      gap: var(--s-5);
    }
    .ftr__links {
      justify-content: flex-start;
    }
    .ftr__meta {
      align-items: flex-start;
    }
  }
</style>
