---
import Monogram from './Monogram.astro';
import { SITE, type Lang } from '../site.config';
import { useTranslations, localizePath, stripLang, otherLang } from '../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const current = stripLang(Astro.url.pathname).replace(/\/+$/, '') || '/';

const nav = [
  { path: '/work', label: t('nav.work') },
  { path: '/writing', label: t('nav.writing') },
  { path: '/about', label: t('nav.about') },
];

const isActive = (p: string) => current === p || current.startsWith(p + '/');
const other = otherLang(lang);
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a class="brand" href={localizePath('/', lang)}>
      <Monogram variant="block" size={26} decorative />
      <span class="brand__text">
        <span class="brand__name">{SITE.name}</span>
        <span class="brand__role">{t('brand.role')}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t('nav.menu')}>
      {
        nav.map((item) => (
          <a
            class:list={['nav__link', { 'is-active': isActive(item.path) }]}
            href={localizePath(item.path, lang)}
            aria-current={isActive(item.path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="nav__lang"
        href={localizePath(current, other)}
        data-lang-switch={other}
        lang={other}
        aria-label={other === 'es' ? 'ES — Cambiar a español' : 'EN — Switch to English'}
      >
        {other.toUpperCase()}
      </a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    min-width: 0;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }

  .brand__name {
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: -0.01em;
  }

  .brand__role {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }

  .nav__link {
    padding: 0.4rem 0.6rem;
    border-radius: var(--r-1);
    font-size: var(--text-sm);
    color: var(--fg-2);
    transition: color var(--dur-1) var(--ease), background var(--dur-1) var(--ease);
  }

  .nav__link:hover {
    color: var(--fg);
    background: var(--surface-2);
  }

  .nav__link.is-active {
    color: var(--fg);
  }

  .nav__link.is-active::after {
    content: '';
    display: block;
    height: 2px;
    margin-top: 2px;
    margin-inline: 0.6rem;
    background: var(--accent);
    border-radius: var(--r-pill);
  }

  .nav__lang {
    margin-left: var(--s-2);
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--line-2);
    border-radius: var(--r-1);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--fg-2);
    transition: border-color var(--dur-1) var(--ease), color var(--dur-1) var(--ease);
  }

  .nav__lang:hover {
    color: var(--fg);
    border-color: var(--ink);
  }

  @media (max-width: 560px) {
    .brand__role {
      display: none;
    }
  }
</style>
