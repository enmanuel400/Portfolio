---
/**
 * Tres propuestas de monograma (E·P — Enmanuel Pirela).
 * variant="serif"  → tile con la serif editorial (ligadura EP)
 * variant="block"  → cuadro entintado con EP vectorial revertido + acento lima
 * variant="line"   → EP vectorial a línea fina + punto de acento
 * Nota: "serif" usa la tipografía viva (Newsreader); al elegir, se contornea a path.
 */
interface Props {
  variant: 'serif' | 'block' | 'line';
  size?: number;
  label?: string;
  decorative?: boolean;
}

const { variant, size = 72, label, decorative = false } = Astro.props;
const aria = label ?? `Monograma Enmanuel Pirela (${variant})`;
const a11y = decorative
  ? { 'aria-hidden': 'true' as const }
  : { role: 'img' as const, 'aria-label': aria };
---

{
  variant === 'serif' && (
    <span class="mg mg--serif" style={`--mg-size:${size}px`} {...a11y}>
      EP
    </span>
  )
}

{
  variant === 'block' && (
    <svg
      class="mg-svg"
      width={size}
      height={size}
      viewBox="0 0 72 72"
      {...a11y}
      fill="none"
    >
      <rect width="72" height="72" rx="16" fill="var(--ink)" />
      <g fill="var(--paper)">
        <rect x="16" y="22" width="5" height="28" />
        <rect x="16" y="22" width="18" height="5" />
        <rect x="16" y="33.5" width="13" height="5" />
        <rect x="16" y="45" width="18" height="5" />
        <rect x="40" y="22" width="5" height="28" />
        <rect x="40" y="22" width="12" height="5" />
        <rect x="47" y="27" width="5" height="11" />
        <rect x="40" y="33.5" width="12" height="5" />
      </g>
      <rect x="54" y="12" width="8" height="8" rx="2" fill="var(--accent)" />
    </svg>
  )
}

{
  variant === 'line' && (
    <svg
      class="mg-svg"
      width={size}
      height={size}
      viewBox="0 0 72 72"
      {...a11y}
      fill="none"
    >
      <g stroke="var(--ink)" stroke-width="4" stroke-linecap="square">
        <path d="M16 22 H34" />
        <path d="M16 36 H30" />
        <path d="M16 50 H34" />
        <path d="M16 22 V50" />
        <path d="M42 22 h10 a8 8 0 0 1 0 16 h-10" />
        <path d="M42 22 V50" />
      </g>
      <circle cx="59" cy="50" r="4" fill="var(--accent)" />
    </svg>
  )
}

<style>
  .mg {
    width: var(--mg-size);
    height: var(--mg-size);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: calc(var(--mg-size) * 0.42);
    letter-spacing: -0.03em;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: 22%;
    line-height: 1;
  }

  .mg-svg {
    display: block;
  }
</style>
