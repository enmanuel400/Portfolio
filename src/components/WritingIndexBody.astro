---
import type { Lang } from '../site.config';
import { useTranslations, localizePath } from '../i18n/utils';
import { posts } from '../data/posts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const list = posts[lang];
---

<section class="wrap page-head">
  <p class="label">{t('nav.writing')}</p>
  <h1 class="display-m">{t('writing.title')}</h1>
  <p class="lede">{t('writing.lede')}</p>
</section>

<section class="wrap">
  <ul class="plist">
    {
      list.map((post, i) => (
        <li class="plist__item">
          <span class="label">{String(i + 1).padStart(2, '0')}</span>
          <div class="plist__body">
            <h2 class="plist__title">{post.title}</h2>
            <p class="plist__desc">{post.description}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .page-head {
    padding-block: var(--s-24) var(--s-12);
    display: grid;
    gap: var(--s-4);
    max-width: 46rem;
  }

  .plist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .plist__item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--s-5);
    padding-block: var(--s-8);
    border-top: 1px solid var(--line);
  }

  .plist__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .plist__body {
    display: grid;
    gap: var(--s-2);
  }

  .plist__title {
    font-size: var(--display-s);
  }

  .plist__desc {
    color: var(--fg-2);
    max-width: 60ch;
    text-wrap: pretty;
  }

  @media (max-width: 620px) {
    .plist__item {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>
