---
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';

const swatches = [
  { name: 'paper', token: '--paper', hex: '#FBFBFA' },
  { name: 'surface', token: '--surface', hex: '#FFFFFF' },
  { name: 'paper-2', token: '--paper-2', hex: '#F4F5F3' },
  { name: 'paper-3', token: '--paper-3', hex: '#ECEDEA' },
  { name: 'ink', token: '--ink', hex: '#121417' },
  { name: 'ink-2', token: '--ink-2', hex: '#3B3F45' },
  { name: 'ink-3', token: '--ink-3', hex: '#63696F' },
  { name: 'ink-4', token: '--ink-4', hex: '#868C92' },
  { name: 'accent', token: '--accent', hex: '#3BE27A' },
  { name: 'accent-ink', token: '--accent-ink', hex: '#0E6B37' },
];

const typeScale = [
  { cls: 'display-l', name: 'display-l', note: 'Titular principal' },
  { cls: 'display-m', name: 'display-m', note: 'Titular de sección' },
  { cls: 'display-s', name: 'display-s', note: 'Titular de tarjeta' },
];

const radii = [
  { token: '--r-1', value: '6px', use: 'Controles (botones, inputs)' },
  { token: '--r-2', value: '10px', use: 'Superficies (tarjetas, imágenes)' },
  { token: '--r-3', value: '16px', use: 'Bloques grandes destacados' },
  { token: '--r-pill', value: '999px', use: 'Etiquetas y pastillas' },
];

const spacing = [
  { token: '--s-1', value: '4px' },
  { token: '--s-2', value: '8px' },
  { token: '--s-3', value: '12px' },
  { token: '--s-4', value: '16px' },
  { token: '--s-6', value: '24px' },
  { token: '--s-8', value: '32px' },
  { token: '--s-12', value: '48px' },
  { token: '--s-16', value: '64px' },
  { token: '--s-24', value: '96px' },
  { token: '--s-32', value: '128px' },
];
---

<Base
  title="Guía de estilo — Enmanuel Pirela"
  description="Sistema de diseño, tipografía, color y propuestas de monograma."
  lang="en"
>
  <header class="wrap sg-head">
    <p class="label">Fase 1 · Sistema de diseño</p>
    <h1 class="display-m" style="margin-top: var(--s-3); max-width: 22ch">
      Guía de estilo y<br />propuestas de identidad
    </h1>
    <p class="lede" style="margin-top: var(--s-6)">
      Página de referencia, no definitiva. Sirve para validar dirección visual antes de
      construir las páginas. Toda medida sale de los tokens, así que un cambio aquí se
      propaga a todo el sitio.
    </p>
  </header>

  <main class="wrap sg">
    <!-- MONOGRAMAS -->
    <section class="sg__block">
      <div class="sg__heading">
        <span class="label">01 · Identidad</span>
        <h2 class="display-s">Tres propuestas de monograma</h2>
        <p class="sg__note">
          Basadas en las iniciales <strong>E·P</strong>. La idea es que funcionen a 24&nbsp;px
          (favicon) y a 96&nbsp;px. Dime cuál te suena y la afino; la de serif se contorneará
          a trazado para no depender de la tipografía.
        </p>
      </div>

      <div class="mono-grid">
        <article class="mono-item card">
          <div class="mono-stage">
            <Monogram variant="serif" size={96} />
            <Monogram variant="serif" size={48} />
            <Monogram variant="serif" size={24} />
          </div>
          <div class="mono-meta">
            <span class="mono">A · Serif</span>
            <p>Ligadura editorial dentro de un cuadrado fino. La más “revista”.</p>
          </div>
        </article>

        <article class="mono-item card">
          <div class="mono-stage">
            <Monogram variant="block" size={96} />
            <Monogram variant="block" size={48} />
            <Monogram variant="block" size={24} />
          </div>
          <div class="mono-meta">
            <span class="mono">B · Bloque</span>
            <p>Cuadro entintado con EP vectorial y punto de acento. Técnica y sólida.</p>
          </div>
        </article>

        <article class="mono-item card">
          <div class="mono-stage">
            <Monogram variant="line" size={96} />
            <Monogram variant="line" size={48} />
            <Monogram variant="line" size={24} />
          </div>
          <div class="mono-meta">
            <span class="mono">C · Línea</span>
            <p>Trazo fino sin contenedor. La más ligera y silenciosa.</p>
          </div>
        </article>
      </div>
    </section>

    <!-- COLOR -->
    <section class="sg__block">
      <div class="sg__heading">
        <span class="label">02 · Color</span>
        <h2 class="display-s">Paleta</h2>
        <p class="sg__note">
          Grises fríos cerca del neutro y un solo acento. El lima directo (<code>--accent</code>)
          va en gráficos y texto grande; para enlaces y texto normal se usa
          <code>--accent-ink</code>, que sí pasa contraste AA sobre el fondo.
        </p>
      </div>

      <ul class="swatches">
        {swatches.map((s) => (
          <li class="swatch card">
            <span class="swatch__chip" style={`background: var(${s.token})`} />
            <div class="swatch__meta">
              <span class="mono">{s.name}</span>
              <span class="swatch__hex mono">{s.hex}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- TIPOGRAFÍA -->
    <section class="sg__block">
      <div class="sg__heading">
        <span class="label">03 · Tipografía</span>
        <h2 class="display-s">Escala y familias</h2>
        <p class="sg__note">
          Serif con carácter solo en titulares. Grotesca neutra para texto largo. Mono
          reservada a etiquetas y datos — es lo único que va en mayúsculas.
        </p>
      </div>

      <div class="type-demo">
        {typeScale.map((t) => (
          <div class="type-row">
            <span class="label type-row__tag">{t.name}</span>
            <p class={t.cls} style="margin: 0">The quick brown fox</p>
          </div>
        ))}

        <div class="type-row">
          <span class="label type-row__tag">lede</span>
          <p class="lede" style="margin: 0">
            Párrafo de entrada: algo más grande, color secundario, ancho controlado para lectura cómoda.
          </p>
        </div>

        <div class="type-row">
          <span class="label type-row__tag">body</span>
          <p style="margin: 0; max-width: 60ch">
            Texto de cuerpo en Schibsted Grotesk. Pensado para lectura larga, con interlineado
            1.62 y ancho de medida contenido. Un párrafo realista que permite juzgar el ritmo y el
            color del texto sobre el papel, no solo una línea de muestra.
          </p>
        </div>

        <div class="type-row">
          <span class="label type-row__tag">label / mono</span>
          <p class="mono" style="margin: 0">
            JETBRAINS MONO · 0123456789 · const render = () =&gt; {}
          </p>
        </div>
      </div>
    </section>

    <!-- COMPONENTES -->
    <section class="sg__block">
      <div class="sg__heading">
        <span class="label">04 · Componentes</span>
        <h2 class="display-s">Primitivas</h2>
      </div>

      <div class="comp-grid">
        <div class="comp card">
          <span class="label">Botones</span>
          <div class="comp__row">
            <button class="btn btn--primary">Ver proyectos</button>
            <button class="btn btn--ghost">Contacto</button>
            <a class="link" href="#top">Enlace de texto</a>
          </div>
        </div>

        <div class="comp card">
          <span class="label">Etiquetas</span>
          <div class="comp__row">
            <span class="tag">Astro</span>
            <span class="tag">TypeScript</span>
            <span class="tag">CSS</span>
          </div>
        </div>

        <div class="comp card">
          <span class="label">Formulario</span>
          <div class="field">
            <label for="demo-email">Email</label>
            <input id="demo-email" type="email" placeholder="tu@correo.com" />
            <span class="field__hint">Nunca comparto tu correo.</span>
          </div>
        </div>

        <div class="comp card">
          <span class="label">Radios</span>
          <ul class="radii">
            {radii.map((r) => (
              <li>
                <span class="radii__box" style={`border-radius: var(${r.token})`} />
                <span class="mono">{r.value}</span>
                <span class="radii__use">{r.use}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="comp card" style="margin-top: var(--s-4)">
        <span class="label">Espaciado (base 4px)</span>
        <div class="spacing">
          {spacing.map((sp) => (
            <span class="spacing__item" title={sp.token}>
              <span class="spacing__bar" style={`width: var(${sp.token})`} />
              <span class="mono">{sp.value}</span>
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- MINI HERO -->
    <section class="sg__block">
      <div class="sg__heading">
        <span class="label">05 · En contexto</span>
        <h2 class="display-s">Mini muestra</h2>
        <p class="sg__note">Cómo se sienten juntos los tokens en una sección real.</p>
      </div>

      <div class="preview card">
        <p class="label">Proyecto destacado</p>
        <h3 class="display-s" style="margin-top: var(--s-3)">miso</h3>
        <p class="lede" style="margin-top: var(--s-3)">
          Buscador descentralizado de películas y series, sin páginas llenas de anuncios.
        </p>
        <div class="preview__foot">
          <div class="preview__tags">
            <span class="tag">Astro</span>
            <span class="tag">APIs</span>
            <span class="tag">UX</span>
          </div>
          <a class="link" href="#top">Ver el caso completo</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap sg-foot">
    <hr class="hairline" />
    <p class="mono" style="padding-top: var(--s-6)">
      Fase 1 · tokens + monogramas · siguiente: contenido de los 3 casos
    </p>
  </footer>
</Base>

<style>
  .sg-head {
    padding-block: var(--s-24) var(--s-12);
  }

  .sg {
    display: grid;
    gap: var(--s-24);
    padding-bottom: var(--s-24);
  }

  .sg__block {
    display: grid;
    gap: var(--s-8);
  }

  .sg__heading {
    display: grid;
    gap: var(--s-3);
    max-width: 62ch;
  }

  .sg__note {
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .sg__note code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    padding: 0.1em 0.35em;
  }

  /* Monogramas */
  .mono-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
  }

  .mono-item {
    overflow: hidden;
  }

  .mono-stage {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    padding: var(--s-8);
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
    min-height: 148px;
  }

  .mono-meta {
    padding: var(--s-5) var(--s-6);
    display: grid;
    gap: var(--s-2);
  }

  .mono-meta p {
    color: var(--fg-2);
    font-size: var(--text-sm);
  }

  .mono-meta .mono {
    color: var(--fg);
  }

  /* Color */
  .swatches {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--s-3);
  }

  .swatch {
    padding: var(--s-3);
    display: grid;
    gap: var(--s-3);
  }

  .swatch__chip {
    display: block;
    height: 72px;
    border-radius: var(--r-1);
    border: 1px solid var(--line);
  }

  .swatch__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
  }

  .swatch__hex {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  /* Tipografía */
  .type-demo {
    display: grid;
    gap: var(--s-8);
  }

  .type-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--s-6);
    align-items: baseline;
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--line);
  }

  .type-row__tag {
    color: var(--muted);
  }

  /* Componentes */
  .comp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--s-4);
  }

  .comp {
    padding: var(--s-6);
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }

  .comp__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
  }

  .radii {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }

  .radii li {
    display: grid;
    grid-template-columns: 40px 56px 1fr;
    align-items: center;
    gap: var(--s-3);
  }

  .radii__box {
    display: block;
    width: 40px;
    height: 32px;
    background: var(--surface-2);
    border: 1px solid var(--line-2);
  }

  .radii__use {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .spacing {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    align-items: flex-end;
  }

  .spacing__item {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
  }

  .spacing__bar {
    display: block;
    height: 24px;
    min-width: 4px;
    background: var(--accent-soft);
    border-left: 2px solid var(--accent-ink);
  }

  /* Preview */
  .preview {
    padding: var(--s-12);
    display: grid;
    gap: var(--s-4);
    background:
      radial-gradient(120% 120% at 100% 0%, var(--accent-soft), transparent 55%),
      var(--surface);
  }

  .preview__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-4);
  }

  .preview__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .sg-foot {
    padding-block: var(--s-8) var(--s-16);
  }

  @media (max-width: 760px) {
    .mono-grid {
      grid-template-columns: 1fr;
    }
    .type-row {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>
