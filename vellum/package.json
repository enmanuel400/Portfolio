{
    "name": "vellum",
    "private": true,
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 5174",
        "desktop": "electron .",
        "build": "vite build",
        "preview": "vite preview",
        "pack": "npm run build && electron-builder"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.3",
        "autoprefixer": "^10.5.6",
        "electron": "^30.0.0",
        "electron-builder": "^24.13.3",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "vite": "^5.4.21"
    },
    "build": {
        "appId": "com.vellum.app",
        "productName": "Vellum",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "main.js"
        ],
        "win": {
            "target": [
                "nsis"
            ]
        },
        "linux": {
            "target": [
                "AppImage"
            ]
        }
    }
}
